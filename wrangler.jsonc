{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cimaly-recovery",
  "main": "./dist/server/index.mjs",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
